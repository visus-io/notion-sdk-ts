{
  "name": "@visus-io/notion-sdk-ts",
  "version": "3.1.1",
  "private": false,
  "description": "TypeScript SDK for the Notion API",
  "keywords": [
    "notion",
    "api",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visus-io/notion-sdk-ts.git"
  },
  "license": "MIT",
  "author": "Visus Development Team",
  "contributors": [
    {
      "name": "Alan Brault",
      "email": "alan.brault@visus.io"
    }
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs:build": "cd docs && bun run build",
    "docs:dev": "cd docs && bun run dev",
    "docs:install": "cd docs && bun install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:html": "eslint . -f html -o reports/lint-report.html",
    "lint:json": "eslint . -f json -o reports/lint-report.json",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-zod": "4.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=18.0.0"
  }
}

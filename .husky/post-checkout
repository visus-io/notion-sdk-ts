# Only run on branch checkouts (not file checkouts — git passes 1 for branch, 0 for file)
if [ "$3" != "1" ]; then
  exit 0
fi

# Check if package.json or bun.lock changed between the previous and new HEAD
CHANGED=$(git diff --name-only "$1" "$2" -- package.json bun.lock 2>/dev/null)

if [ -n "$CHANGED" ]; then
  echo "Detected changes in: $CHANGED"
  echo "Running bun install..."
  if command -v bun >/dev/null 2>&1; then
    bun install
  else
    echo "Bun is not installed. Please install Bun."
    exit 1
  fi
fi

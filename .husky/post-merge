# Check if package.json or bun.lock changed as a result of the merge
CHANGED=$(git diff --name-only ORIG_HEAD HEAD -- package.json bun.lock 2>/dev/null)

if [ -n "$CHANGED" ]; then
  echo "Detected changes in: $CHANGED"
  echo "Running bun install..."
  if command -v bun >/dev/null 2>&1; then
    bun install
  else
    echo "Bun is not installed. Please install Bun."
    exit 1
  fi
fi
